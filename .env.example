# Variáveis de ambiente - Frontend Zupps Eats
# Copie este arquivo para .env e preencha com os valores reais

# URL base do backend (local ou produção)
VITE_API_BASE_URL=http://localhost:5000

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=sua_google_maps_api_key

# Login Social — Google OAuth 2.0
# Obtenha em: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com

# Login Social — Facebook App
# Obtenha em: https://developers.facebook.com/apps
VITE_FACEBOOK_APP_ID=seu_facebook_app_id
